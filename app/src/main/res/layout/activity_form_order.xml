<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_midnight"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- Header Atas: Tombol Kembali + Judul Form -->
        <ImageView
            android:id="@+id/btnBackForm"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/btn_batal"
            android:focusable="true"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintBottom_toBottomOf="@id/tvFormHeaderTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvFormHeaderTitle"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvFormHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/title_buat_panggilan"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBackForm"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 1. Tipe Mobil -->
        <TextView
            android:id="@+id/lblTipeMobil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_tipe_mobil"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFormHeaderTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFormTipeMobil"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="@color/surface_frosted"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/stroke_slate"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblTipeMobil">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFormTipeMobil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_tipe_mobil"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Plat Nomor -->
        <TextView
            android:id="@+id/lblPlatNomor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_plat_nomor"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilFormTipeMobil" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFormPlatNomor"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="@color/surface_frosted"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/stroke_slate"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblPlatNomor">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFormPlatNomor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_plat_nomor"
                android:inputType="textCapCharacters"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Kategori Masalah (Dropdown) -->
        <TextView
            android:id="@+id/lblKategoriMasalah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_kategori_masalah"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilFormPlatNomor" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFormKategori"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="@color/surface_frosted"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/stroke_slate"
            app:endIconTint="@color/text_secondary"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblKategoriMasalah">

            <AutoCompleteTextView
                android:id="@+id/actvKategoriMasalah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingVertical="14dp"
                android:text="Aki Tekor / Kelistrikan"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4. Pilih Jenis Penanganan (2 Kartu Berdampingan) -->
        <TextView
            android:id="@+id/lblJenisPenanganan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_jenis_penanganan"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilFormKategori" />

        <LinearLayout
            android:id="@+id/layoutPilihanPenanganan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblJenisPenanganan">

            <!-- Kartu Kiri: Servis di Lokasi (Rp 150.000) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPilihServisLokasi"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/badge_service_green_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_electric_blue"
                app:strokeWidth="1.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvTitlePilihLokasi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Servis di Lokasi"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHargaPilihLokasi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="• Rp 150.000"
                        android:textColor="@color/badge_service_green"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kartu Kanan: Derek ke Bengkel (Rp 350.000) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPilihDerekBengkel"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_frosted"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_slate"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvTitlePilihDerek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Derek ke Bengkel"
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHargaPilihDerek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="• Rp 350.000"
                        android:textColor="@color/text_hint"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 5. Deskripsi Keluhan -->
        <TextView
            android:id="@+id/lblDeskripsi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_deskripsi_keluhan"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPilihanPenanganan" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFormDeskripsi"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="@color/surface_frosted"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/stroke_slate"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblDeskripsi">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFormDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/hint_deskripsi_keluhan"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 6. Titik Lokasi Mogok + Tombol Ambil GPS -->
        <TextView
            android:id="@+id/lblTitikLokasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_titik_lokasi"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilFormDeskripsi" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLokasiContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/surface_frosted"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_slate"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblTitikLokasi">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/label_titik_lokasi"
                    android:src="@android:drawable/ic_dialog_map"
                    app:tint="@color/primary_electric_blue" />

                <EditText
                    android:id="@+id/etFormLokasi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_lokasi_manual"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAmbilGps"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/btn_ambil_gps"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_electric_blue"
                    app:cornerRadius="19dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. Kotak Foto Kondisi Mobil (Kamera / Galeri) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUploadFoto"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_frosted"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_slate"
            app:strokeWidth="1.2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardLokasiContainer">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Pratinjau Foto setelah diambil -->
                <ImageView
                    android:id="@+id/ivPreviewFotoMobil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/label_tambah_foto"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Placeholder Sebelum Foto Diambil -->
                <LinearLayout
                    android:id="@+id/layoutPlaceholderFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/label_tambah_foto"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/primary_electric_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/label_tambah_foto"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Badge Ubah Foto di Pojok Kanan Atas saat foto sudah ada -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badgeUbahFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/bg_midnight"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/stroke_slate"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/btn_ubah_foto"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 8. Tombol Utama: Kirim Panggilan Darurat / Simpan Perubahan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitOrder"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/btn_kirim_panggilan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_electric_blue"
            app:cornerRadius="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardUploadFoto" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>